# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# For local development run `npm run db:start` and copy the printed values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never expose to the browser, never prefix NEXT_PUBLIC_.
# Used by booking orchestration, waitlist promotion and hold expiry.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3210

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# mock  — local/demo provider, always labelled as such in the UI
# omise — reserved, not implemented
PAYMENT_PROVIDER=mock

# Mock provider behaviour. Percentage of charges that deliberately fail so the
# failure UI can be exercised. 0 disables simulated failures.
MOCK_PAYMENT_FAILURE_RATE=0

# ---------------------------------------------------------------------------
# LINE (integration points only — the app runs on email auth without these)
# ---------------------------------------------------------------------------
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
NEXT_PUBLIC_LINE_LIFF_ID=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Scheduled jobs
# ---------------------------------------------------------------------------
# Shared secret required by POST /api/cron/* (hold expiry, payment expiry).
CRON_SECRET=dev-cron-secret
